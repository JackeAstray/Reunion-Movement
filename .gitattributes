# Git 属性约定
# 说明：索引中文本文件已统一以 LF 存储，新增规则不会产生 renormalize 差异。
#      大体积二进制从本次提交起走 Git LFS（历史中的旧 blob 不迁移，见 Docs/仓库维护.md）。

# 默认：由 Git 自动识别文本并归一化
* text=auto
# ---- Unity 文本资源（YAML / JSON），保持可读 diff ----
*.unity        text
*.prefab       text
*.asset        text
*.mat          text
*.anim         text
*.controller   text
*.overrideController text
*.meta         text
*.asmdef       text
*.asmref       text
*.shader       text
*.cginc        text
*.hlsl         text
*.cs           text diff=csharp
*.md           text
# ---- 大体积二进制：后续提交走 Git LFS ----
*.gif           filter=lfs diff=lfs merge=lfs -text
*.unitypackage  filter=lfs diff=lfs merge=lfs -text
*.psd          filter=lfs diff=lfs merge=lfs -text
*.otf          filter=lfs diff=lfs merge=lfs -text
*.ttf          filter=lfs diff=lfs merge=lfs -text
*.fbx          filter=lfs diff=lfs merge=lfs -text
*.mp4          filter=lfs diff=lfs merge=lfs -text
# ---- 其余二进制：禁止行尾转换与文本 diff ----
*.png    binary
*.jpg    binary
*.jpeg   binary
*.exr    binary
*.tga    binary
*.wav    binary
*.ogg    binary
*.mp3    binary
*.dll    binary
*.so     binary
*.a      binary
*.aar    binary
*.jar    binary
*.bytes  binary
*.zip    binary
*.7z     binary
*.gif filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
